{
    "private": true,
    "name": "@cichol/packages",
    "description": "The centralized repository of npm packages for personal projects.",
    "homepage": "https://github.com/morrighan/packages",
    "bugs": {
        "url": "https://github.com/morrighan/packages/issues"
    },
    "author": {
        "name": "Yongbin Min",
        "email": "contact@cichol.com",
        "url": "https://www.cichol.com/"
    },
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/morrighan/packages.git"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "yarn build:individual && yarn build:rollup && yarn build:dts",
        "build:individual": "yarn workspaces foreach -A run build",
        "build:rollup": "yarn rollup --config --silent",
        "build:dts": "node scripts/typings.js",
        "test": "yarn test:eslint && yarn test:tsc && yarn test:vitest",
        "test:eslint": "yarn eslint .",
        "test:tsc": "find packages/* -mindepth 0 -maxdepth 0 -type d -exec sh -c \"yarn tsc --project {} --noEmit\" \\;",
        "test:vitest": "yarn vitest run",
        "version": "yarn workspaces foreach -A --no-private exec npm pkg set version=\"$(git symbolic-ref --short HEAD | sed 's/.*\\///')\""
    },
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@babel/plugin-proposal-decorators": "^8.0.2",
        "@babel/plugin-transform-runtime": "^8.0.1",
        "@babel/preset-env": "^8.0.2",
        "@babel/preset-typescript": "^8.0.1",
        "@babel/runtime-corejs3": "^8.0.0",
        "@cichol/eslint-config": "file:./packages/eslint-config",
        "@microsoft/api-extractor": "^7.58.12",
        "@rolldown/plugin-babel": "^0.2.3",
        "@rollup/plugin-babel": "^7.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@types/babel__core": "^7.20.5",
        "@types/babel__helper-plugin-utils": "^7.10.3",
        "@types/chroma-js": "^3.1.2",
        "@types/luxon": "^3.7.4",
        "@types/morgan": "^1.9.10",
        "@types/node": "^24.13.3",
        "@vitest/coverage-v8": "^4.1.10",
        "babel-plugin-polyfill-corejs3": "^1.0.0",
        "core-js-pure": "^3.50.0",
        "eslint": "^9.39.5",
        "execa": "^10.0.1",
        "ora": "^9.4.1",
        "postcss": "^8.4.49",
        "rolldown": "^1.0.0-rc.5",
        "rollup": "^4.62.4",
        "stylelint": "^17.14.1",
        "tsc-alias": "^1.9.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10"
    },
    "resolutions": {
        "cls-rtracer/uuid": "^14.0.1"
    },
    "engines": {
        "node": "^24.18.0"
    },
    "packageManager": "yarn@4.18.0"
}
