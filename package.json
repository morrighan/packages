{
    "private": true,
    "name": "@cichol/packages",
    "description": "The centralized repository of npm packages for personal projects.",
    "homepage": "https://github.com/morrighan/packages",
    "bugs": {
        "url": "https://github.com/morrighan/packages/issues"
    },
    "author": {
        "name": "Yongbin Min",
        "email": "contact@cichol.com",
        "url": "https://www.cichol.com/"
    },
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/morrighan/packages.git"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "yarn build:individual && yarn build:rollup && yarn build:dts",
        "build:individual": "yarn workspaces foreach -Aptiv --no-private run build",
        "build:rollup": "yarn rollup --config --silent",
        "build:dts": "node scripts/typings.js",
        "test": "yarn test:eslint && yarn test:tsc && yarn test:vitest",
        "test:eslint": "yarn eslint .",
        "test:tsc": "yarn workspaces foreach -Apv --no-private exec yarn run -T tsc --project . --noEmit",
        "test:vitest": "yarn vitest run",
        "version": "yarn workspaces foreach -Apv --no-private exec npm pkg set version=\"$(git symbolic-ref --short HEAD | sed 's/.*\\///')\""
    },
    "devDependencies": {
        "@babel/core": "^8.0.9",
        "@babel/plugin-proposal-decorators": "^8.0.2",
        "@babel/plugin-transform-runtime": "^8.0.6",
        "@babel/preset-env": "^8.0.7",
        "@babel/preset-typescript": "^8.0.7",
        "@babel/runtime-corejs3": "^8.0.8",
        "@cichol/eslint-config": "workspace:*",
        "@microsoft/api-extractor": "^7.59.4",
        "@rolldown/plugin-babel": "^0.2.4",
        "@rollup/plugin-babel": "^7.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@types/babel__core": "^7.20.5",
        "@types/babel__helper-plugin-utils": "^7.10.3",
        "@types/chroma-js": "^3.1.3",
        "@types/luxon": "^3.7.6",
        "@types/morgan": "^1.9.10",
        "@types/node": "^24.19.2",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitest/coverage-v8": "^5.0.5",
        "babel-plugin-polyfill-corejs3": "^1.0.0",
        "core-js-pure": "^3.51.0",
        "eslint": "^10.13.0",
        "execa": "^10.2.1",
        "ora": "^9.4.1",
        "postcss": "^8.5.31",
        "rolldown": "^1.2.15",
        "rollup": "^4.65.1",
        "stylelint": "^17.16.0",
        "tsc-alias": "^1.9.9",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "resolutions": {
        "cls-rtracer/uuid": "^14.0.2"
    },
    "engines": {
        "node": "^24.21.0"
    },
    "packageManager": "yarn@4.18.1"
}
